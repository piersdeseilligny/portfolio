{"documents":[{"title":"Clipflow","typeoverride":null,"nopostershadow":true,"description":"A cross-platform application, still in early development, which enables on-set video assist, editing, and camera-to-cloud workflows in an extremely simple and affordable package. Currently compatible with Sony FX6, FX3, Venice, Venice 2, and Burano. Support planned for Red and Blackmagic cameras.\n\nSoftware package of multiple applications:\n- Clipflow Server, run on a central laptop or mobile device: ingests and processes clips *as soon as they're shot*. \n- Clipflow Client, which can run on over a dozen mobile devices. Allows anyone on-set to review and leave notes on clips. Either in real-time, or on previously recorded clips.\n\n**Not currently available to the public, please enquire for more details**","shortdescription":null,"contentblocks":[],"moreinfo":[],"date":"2024-06-18","id":"t8v7h5km0667ptye1e4jvv96","slug":"clipflow","backgroundcolor":"#03232e","foregroundcolor":"#ffffff","foregroundcolor2":"#ffffff","images":[{"formats":{"thumbnail":{"name":"thumbnail_clipflow.webp","hash":"thumbnail_clipflow_4b8717815c","ext":".webp","mime":"image/webp","width":245,"height":130,"size":2.39,"path":null,"url":"/uploads/thumbnail_clipflow_4b8717815c.webp"},"large":{"name":"large_clipflow.webp","hash":"large_clipflow_4b8717815c","ext":".webp","mime":"image/webp","width":1500,"height":797,"size":133.18,"path":null,"url":"/uploads/large_clipflow_4b8717815c.webp"},"medium":{"name":"medium_clipflow.webp","hash":"medium_clipflow_4b8717815c","ext":".webp","mime":"image/webp","width":750,"height":398,"size":16.85,"path":null,"url":"/uploads/medium_clipflow_4b8717815c.webp"},"small":{"name":"small_clipflow.webp","hash":"small_clipflow_4b8717815c","ext":".webp","mime":"image/webp","width":500,"height":266,"size":7.18,"path":null,"url":"/uploads/small_clipflow_4b8717815c.webp"}},"url":"/uploads/clipflow_4b8717815c.webp"}],"poster":{"formats":{"thumbnail":{"name":"thumbnail_MacOS Icon copy.