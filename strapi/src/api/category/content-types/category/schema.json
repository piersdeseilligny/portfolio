{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "documents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::document.document",
      "inversedBy": "categories"
    },
    "slug": {
      "type": "string"
    },
    "thumbnailvideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "thumbnailimage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    }
  }
}