{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "date": {
      "type": "date"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "documents"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "documents"
    },
    "slug": {
      "type": "string"
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "backgroundcolor": {
      "type": "string"
    },
    "foregroundcolor": {
      "type": "string"
    },
    "contentblocks": {
      "type": "component",
      "repeatable": true,
      "component": "component.contentblock"
    },
    "foregroundcolor2": {
      "type": "string"
    },
    "moreinfo": {
      "type": "component",
      "repeatable": true,
      "component": "component.moreinfo"
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "typeoverride": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "nopostershadow": {
      "type": "boolean"
    },
    "shortdescription": {
      "type": "text",
      "maxLength": 200
    },
    "nopage": {
      "type": "boolean"
    },
    "np_link": {
      "type": "string"
    },
    "hero": {
      "type": "boolean",
      "default": false
    },
    "laurels": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    }
  }
}